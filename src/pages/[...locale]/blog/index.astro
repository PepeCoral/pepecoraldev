---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import Layout from "../../../layouts/Layout.astro";
import PostCard from "../../../components/blog/PostCard.astro";

export { getLocaleStaticPaths as getStaticPaths } from "../../../i18n/routes";
import getTranslation from "../../../i18n";

const locale = Astro.params.locale ?? "en";
const t = getTranslation(locale);

const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");

const posts = allPosts.filter((post) => post.data.locale === locale);

const sortedPosts = posts.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout t={t} page={t.blog}>
    <h1 class="mb-8 text-3xl font-bold">{t.blog.h1}</h1>

    <p class="mb-6 text-sm text-base-content/50">
        {sortedPosts.length}&nbsp;{t.blog.posts}
    </p>

    <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {sortedPosts.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
</Layout>
