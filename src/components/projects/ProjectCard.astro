---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, tags, image, url, github, featured } = project.data;
---

<a
    href={`/projects/${project.id}`}
    class:list={[
        "card bg-base-100 shadow-md transition-shadow duration-300 hover:shadow-xl",
        featured ? "border-2 border-primary" : "",
    ]}
    data-title={title.toLowerCase()}
    data-tags={tags.join(",").toLowerCase()}
>
    <figure class="aspect-video overflow-hidden">
        <Image
            src={image}
            alt={title}
            width={600}
            height={340}
            class="h-full w-full object-cover"
        />
    </figure>
    <div class="card-body">
        {
            featured && (
                <span class="badge badge-primary badge-sm w-fit font-bold">
                    Featured
                </span>
            )
        }
        <h3 class="card-title text-lg">{title}</h3>
        <p class="line-clamp-2 text-sm text-base-content/60">{description}</p>
        <div class="mt-2 flex flex-wrap gap-2">
            {
                tags.slice(0, 3).map((tag: string) => (
                    <span class="badge badge-outline badge-sm">{tag}</span>
                ))
            }
        </div>
        {
            (url || github) && (
                <div class="card-actions mt-3 justify-end gap-2">
                    {url && <span class="btn btn-primary btn-xs">Live demo</span>}
                    {github && (
                        <span class="btn btn-outline btn-xs">GitHub</span>
                    )}
                </div>
            )
        }
    </div>
</a>
