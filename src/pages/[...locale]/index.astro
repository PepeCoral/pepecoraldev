---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { CollectionEntry } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import PostCard from "../../components/blog/PostCard.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";

import getTranslation from "../../i18n";
export { getLocaleStaticPaths as getStaticPaths } from "../../i18n/routes";

const locale = Astro.params.locale ?? "en";
const t = getTranslation(locale);

const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");

const posts = allPosts.filter((post) => post.data.locale === locale);

const recentPosts = posts
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const allProjects: CollectionEntry<"projects">[] =
	await getCollection("projects");

const projects = allProjects.filter(
	(project) => project.data.locale === locale,
);

const socials = [
	{
		label: "GitHub",
		href: "https://github.com/pepecoral",
		icon: "github",
	},
	{
		label: "LinkedIn",
		href: "https://linkedin.com/in/pepe-coral",
		icon: "linkedin",
	},
];
---

<Layout t={t} page={t.home}>
	<section class="hero">
		<div class="hero-content flex-col text-center">
			<div class="avatar mb-6">
				<div class="w-28 sm:w-32 overflow-hidden rounded-full">
					<img
						class="skeleton aspect-square"
						src="/avatar.png"
						alt="Pepe Coral"
						style="color: transparent"
					/>
				</div>
			</div>

			<div class="badge badge-primary badge-outline mb-3">
				{t.home.workAvailable}
			</div>

			<h1 class="text-4xl sm:text-5xl font-bold">{t.home.h1}</h1>
			<p class="py-4 max-w-xl text-base-content/70">
				{t.home.body}
			</p>

			<div class="flex flex-wrap items-center justify-center gap-3">
				<button
					id="copy-email"
					type="button"
					class="btn btn-primary transition-colors duration-300"
					data-email="hello@pepecoral.dev"
				>
					<Icon name="copy" />
					<span id="copy-label" class="grid">
						<span class="col-start-1 row-start-1" data-copy-label-default
							>{t.home.copyEmail}</span
						>
						<span
							class="col-start-1 row-start-1 invisible"
							data-copy-label-copied
							>{t.home.copied}</span
						>
					</span>
				</button>
				<a href="/cv.pdf" download class="btn btn-outline">
					<Icon name="download" />
					{t.home.downloadCv}
				</a>

				{
					socials.map((s) => (
						<a
							href={s.href}
							target="_blank"
							rel="noopener noreferrer"
							class="btn
							btn-outline"
						>
							<Icon name={s.icon} />
							{s.label}
						</a>
					))
				}
			</div>
		</div>
	</section>

	<div class="divider"></div>

	<section>
		<div class="mb-6 flex items-center justify-between">
			<h2 class="text-2xl font-bold">{t.home.featuredProjects}</h2>
			<a
				href={getRelativeLocaleUrl(locale, "/projects")}
				class="link link-primary text-sm font-medium"
			>
				{t.home.viewAllProjects} &rarr;
			</a>
		</div>

		{
			projects.length > 0 ? (
				<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{projects.map((project) => (
						<ProjectCard project={project} locale={locale} t={t} />
					))}
				</div>
			) : (
				<p class="text-base-content/50 text-sm">
					No projects yet — check back soon.
				</p>
			)
		}
	</section>

	<div class="divider"></div>

	<section>
		<div class="mb-6 flex items-center justify-between">
			<h2 class="text-2xl font-bold">{t.home.latestPosts}</h2>
			<a
				href={getRelativeLocaleUrl(locale, "/blog")}
				class="link link-primary text-sm font-medium"
			>
				{t.home.viewAllPosts} &rarr;
			</a>
		</div>

		{
			recentPosts.length > 0 ? (
				<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{recentPosts.map((post) => (
						<PostCard post={post} locale={locale} />
					))}
				</div>
			) : (
				<p class="text-base-content/50 text-sm">
					No posts yet — check back soon.
				</p>
			)
		}
	</section>

	<script>
		const email = "hello@pepecoral.dev";
		const button = document.querySelector<HTMLButtonElement>("#copy-email");

		if (button) {
			const defaultLabel =
				button.querySelector<HTMLSpanElement>("[data-copy-label-default]");
			const copiedLabel =
				button.querySelector<HTMLSpanElement>("[data-copy-label-copied]");

			let timeout: number | undefined;

			button.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(email);

					button.classList.remove("btn-primary");
					button.classList.add("btn-secondary");

					button.classList.remove("animate-copied-pop");
					void button.offsetWidth;
					button.classList.add("animate-copied-pop");

					defaultLabel?.classList.add("invisible");
					copiedLabel?.classList.remove("invisible");

					clearTimeout(timeout);
					timeout = window.setTimeout(() => {
						defaultLabel?.classList.remove("invisible");
						copiedLabel?.classList.add("invisible");

						button.classList.remove("btn-secondary", "animate-copied-pop");
						button.classList.add("btn-primary");
					}, 2000);
				} catch {
					window.location.href = `mailto:${email}`;
				}
			});
		}
	</script>
</Layout>
