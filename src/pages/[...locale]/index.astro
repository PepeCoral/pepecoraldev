---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { CollectionEntry } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/blog/PostCard.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";

import getTranslation from "../../i18n";
export { getLocaleStaticPaths as getStaticPaths } from "../../i18n/routes";

const locale = Astro.params.locale ?? "en";
const t = getTranslation(locale);

const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");

const posts = allPosts.filter((post) => post.data.locale === locale);

const recentPosts = posts
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const allProjects: CollectionEntry<"projects">[] =
	await getCollection("projects");

const projects = allProjects.filter(
	(project) => project.data.locale === locale,
);

const socials = [
	{ label: "GitHub", href: "https://github.com/pepecoral" },
	{ label: "LinkedIn", href: "https://linkedin.com/in/pepe-coral" },
];
---

<Layout t={t} page={t.home}>
	<section class="hero">
		<div class="hero-content flex-col text-center">
			<div class="avatar mb-6">
				<div class="w-28 sm:w-32 rounded-full">
					<img src="/avatar.png" alt="Pepe Coral" />
				</div>
			</div>

			<div class="badge badge-primary badge-outline mb-3">
				{t.home.workAvailable}
			</div>

			<h1 class="text-4xl sm:text-5xl font-bold">{t.home.h1}</h1>
			<p class="py-4 max-w-xl text-base-content/70">
				{t.home.body}
			</p>

			<div class="flex flex-wrap justify-center gap-3">
				<a href="mailto:hello@pepecoral.dev" class="btn btn-primary">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="size-4"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					>
						<rect x="2" y="4" width="20" height="16" rx="2"></rect>
						<path d="m22 6-10 7L2 6"></path>
					</svg>
					{t.home.getInTouch}
				</a>

				{
					socials.map((s) => (
						<a
							href={s.href}
							target="_blank"
							rel="noopener noreferrer"
							class="btn
							btn-outline"
						>
							{s.label}
						</a>
					))
				}
			</div>
		</div>
	</section>

	<div class="divider"></div>

	<section>
		<div class="mb-6 flex items-center justify-between">
			<h2 class="text-2xl font-bold">{t.home.featuredProjects}</h2>
			<a
				href={getRelativeLocaleUrl(locale, "/projects")}
				class="link link-primary text-sm font-medium"
			>
				{t.home.viewAllProjects} &rarr;
			</a>
		</div>

		{
			projects.length > 0 ? (
				<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{projects.map((project) => (
						<ProjectCard project={project} locale={locale} t={t} />
					))}
				</div>
			) : (
				<p class="text-base-content/50 text-sm">
					No projects yet — check back soon.
				</p>
			)
		}
	</section>

	<div class="divider"></div>

	<section>
		<div class="mb-6 flex items-center justify-between">
			<h2 class="text-2xl font-bold">{t.home.latestPosts}</h2>
			<a
				href={getRelativeLocaleUrl(locale, "/blog")}
				class="link link-primary text-sm font-medium"
			>
				{t.home.viewAllPosts} &rarr;
			</a>
		</div>

		{
			recentPosts.length > 0 ? (
				<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{recentPosts.map((post) => (
						<PostCard post={post} locale={locale} />
					))}
				</div>
			) : (
				<p class="text-base-content/50 text-sm">
					No posts yet — check back soon.
				</p>
			)
		}
	</section>
</Layout>
