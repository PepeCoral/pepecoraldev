---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { CollectionEntry } from "astro:content";
import Icon from "../Icon.astro";
import type { Translation } from "../../i18n/types";

interface Props {
    project: CollectionEntry<"projects">;
    locale: string;
    t: Translation;
}

const { project, locale, t } = Astro.props;
const { title, description, tags, image, links, featured } = project.data;

const projectUrl = getRelativeLocaleUrl(
    locale,
    `/projects/${project.data.slug}`,
);
---

<a
    href={projectUrl}
    class:list={[
        "card bg-base-100 shadow-md transition-shadow duration-300 hover:shadow-xl",
        featured ? "border-2 border-primary" : "",
    ]}
    data-title={title.toLowerCase()}
    data-tags={tags.join(",").toLowerCase()}
>
    <figure class="aspect-video overflow-hidden">
        <Image
            src={image}
            alt={title}
            width={600}
            height={340}
            class="skeleton h-full w-full object-cover"
            style="color: transparent"
        />
    </figure>
    <div class="card-body">
        {
            featured && (
                <span class="badge badge-primary badge-sm w-fit font-bold">
                    {t.projects.featured}
                </span>
            )
        }
        <h3 class="card-title text-lg">{title}</h3>
        <p class="text-sm text-base-content/60">{description}</p>
        <div class="mt-2 flex flex-wrap gap-2">
            {
                tags
                    .slice(0, 3)
                    .map((tag: string) => (
                        <span class="badge badge-outline badge-sm">{tag}</span>
                    ))
            }
        </div>
        {
            links.length > 0 && (
                <div class="card-actions mt-3 justify-end gap-2">
                    {links.map((link) => (
                        <span
                            class:list={[
                                link.cardClass ?? "btn btn-outline btn-xs",
                            ]}
                        >
                            <span class="inline-flex items-center gap-1.5">
                                {link.icon && (
                                    <Icon name={link.icon} class="size-3.5" />
                                )}
                                {link.card}
                            </span>
                        </span>
                    ))}
                </div>
            )
        }
    </div>
</a>
