---
import Layout from "../../layouts/Layout.astro";
import getTranslation from "../../i18n";
export { getLocaleStaticPaths as getStaticPaths } from "../../i18n/routes";
const t = getTranslation(Astro.params.locale);
---

<Layout t={t} page={t.contact}>
    <header class="mb-4">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
            {t.contact.h1}
        </h1>

        <p class="mt-5 text-lg text-base-content/70">
            {t.contact.subtitle}
        </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="card border border-base-300 bg-base-200/50 lg:col-span-1">
            <div class="card-body">
                <h2 class="card-title">{t.contact.getInTouch}</h2>

                <div class="divider my-1"></div>

                <div>
                    <div class="text-sm text-base-content/60">
                        {t.contact.emailLabel}
                    </div>

                    <button
                        id="copy-email-info"
                        type="button"
                        class="link link-primary mt-1 text-left font-medium"
                        data-email="hello@pepecoral.dev"
                    >
                        hello@pepecoral.dev
                    </button>
                </div>

                <div class="mt-6">
                    <div class="text-sm text-base-content/60 mb-2">
                        {t.contact.elsewhereLabel}
                    </div>

                    <div class="flex flex-col gap-2">
                        <a
                            href="https://github.com/pepecoral"
                            class="btn
                        btn-outline btn-block justify-start gap-3"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <svg
                                class="h-5 w-5 fill-current"
                                viewBox="0 0 16 16"
                                aria-hidden="true"
                            >
                                <path
                                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                                ></path>
                            </svg>
                            {t.contact.github}
                        </a>

                        <a
                            href="https://www.linkedin.com/in/pepe-coral"
                            class="btn btn-outline
                    btn-block justify-start gap-3"
                            target="_blank"
                            rel="noopener
                    noreferrer"
                        >
                            <svg
                                class="h-5 w-5 fill-current"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"
                                ></path>
                            </svg>
                            {t.contact.linkedin}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-primary text-primary-content lg:col-span-2">
            <div class="card-body flex flex-col justify-center gap-6">
                <div>
                    <h2 class="card-title text-2xl sm:text-3xl">
                        {t.contact.ctaTitle}
                    </h2>

                    <p class="mt-3 max-w-lg opacity-80">
                        {t.contact.ctaBody}
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <button
                        id="copy-email"
                        type="button"
                        class="btn btn-neutral btn-lg"
                        data-email="hello@pepecoral.dev"
                    >
                        {t.contact.copyEmail}
                    </button>

                    <div
                        id="copy-success"
                        class="badge badge-success hidden"
                        role="status"
                        aria-live="polite"
                    >
                        {t.contact.copied}
                    </div>
                </div>
            </div>
        </div>

        <script>
            const email = "hello@pepecoral.dev";
            const buttons =
                document.querySelectorAll<HTMLButtonElement>("[data-email]");
            const success = document.querySelector("#copy-success");

            buttons.forEach((button) => {
                button.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(email);

                        success?.classList.remove("hidden");

                        setTimeout(() => {
                            success?.classList.add("hidden");
                        }, 2000);
                    } catch {
                        window.location.href = `mailto:${email}`;
                    }
                });
            });
        </script>
    </div>
</Layout>
