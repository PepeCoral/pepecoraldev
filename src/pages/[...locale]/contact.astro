---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import getTranslation from "../../i18n";
export { getLocaleStaticPaths as getStaticPaths } from "../../i18n/routes";
const t = getTranslation(Astro.params.locale);
---

<Layout t={t} page={t.contact}>
    <header class="mb-4">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
            {t.contact.h1}
        </h1>

        <p class="mt-5 text-lg text-base-content/70">
            {t.contact.subtitle}
        </p>
    </header>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="card border border-base-300 bg-base-200/50 lg:col-span-1">
            <div class="card-body">
                <h2 class="card-title">{t.contact.getInTouch}</h2>

                <div class="divider my-1"></div>

                <div>
                    <div class="text-sm text-base-content/60">
                        {t.contact.emailLabel}
                    </div>

                    <button
                        id="copy-email-info"
                        type="button"
                        class="link link-primary mt-1 text-left font-medium"
                        data-email="hello@pepecoral.dev"
                    >
                        hello@pepecoral.dev
                    </button>
                </div>

                <div class="mt-6">
                    <div class="text-sm text-base-content/60 mb-2">
                        {t.contact.elsewhereLabel}
                    </div>

                    <div class="flex flex-col gap-2">
                        <a
                            href="https://github.com/pepecoral"
                            class="btn
                        btn-outline btn-block justify-start gap-3"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Icon name="github" class="h-5 w-5" />
                            {t.contact.github}
                        </a>

                        <a
                            href="https://www.linkedin.com/in/pepe-coral"
                            class="btn btn-outline
                    btn-block justify-start gap-3"
                            target="_blank"
                            rel="noopener
                    noreferrer"
                        >
                            <Icon name="linkedin" class="h-5 w-5" />
                            {t.contact.linkedin}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-primary text-primary-content lg:col-span-2">
            <div class="card-body flex flex-col justify-center gap-6">
                <div>
                    <h2 class="card-title text-2xl sm:text-3xl">
                        {t.contact.title}
                    </h2>

                    <p class="mt-3 max-w-lg opacity-80">
                        {t.contact.description}
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <button
                        id="copy-email"
                        type="button"
                        class="btn btn-neutral btn-lg"
                        data-email="hello@pepecoral.dev"
                    >
                        <Icon name="copy" />
                        {t.contact.copyEmail}
                    </button>

                    <a href="/cv.pdf" download class="btn btn-main btn-lg">
                        <Icon name="download" />
                        {t.contact.downloadCv}
                    </a>

                    <div
                        id="copy-success"
                        class="badge badge-success hidden"
                        role="status"
                        aria-live="polite"
                    >
                        {t.contact.copied}
                    </div>
                </div>
            </div>
        </div>

        <script>
            const email = "hello@pepecoral.dev";
            const buttons =
                document.querySelectorAll<HTMLButtonElement>("[data-email]");
            const success = document.querySelector("#copy-success");

            buttons.forEach((button) => {
                button.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(email);

                        success?.classList.remove("hidden");

                        setTimeout(() => {
                            success?.classList.add("hidden");
                        }, 2000);
                    } catch {
                        window.location.href = `mailto:${email}`;
                    }
                });
            });
        </script>
    </div>
</Layout>
