---
const currentPath = Astro.url.pathname;

const navItems = [
    { href: "/projects", label: "/projects" },
    { href: "/blog", label: "/blog" },
    { href: "/contact", label: "/contact" },
];

const isActive = (href: string) => currentPath.startsWith(href);
---

<div
    class="navbar bg-base-100 shadow-sm max-w-2xl mx-auto rounded-full px-4 my-5"
>
    <div class="navbar-start">
        <a class="ml-4 font-bold text-xl text-primary" href="/"> Pepe Coral </a>
    </div>

    <ul class="navbar-end flex menu menu-horizontal px-1">
        {
            navItems.map(({ href, label }) => (
                <li>
                    <a
                        href={href}
                        class:list={{ "text-primary": isActive(href) }}
                    >
                        {label}
                    </a>
                </li>
            ))
        }
    </ul>
</div>
