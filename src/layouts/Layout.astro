---
import "../assets/app.css";
import Navbar from "../components/Navbar.astro";
import type { PageTranslation, Translation } from "../i18n/types";

interface Props {
	page: PageTranslation;
	t: Translation;
}

const { t, page } = Astro.props;
---

<!doctype html>
<html lang={t.locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<link rel="icon" href="/favicon.png" />

		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={page.description} />

		<title>{page.title}</title>

		<!-- Google tag (gtag.js) -->
		<script
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-63J11D26LB"
		></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-63J11D26LB");
		</script>
	</head>

	<body class="min-h-screen">
		<Navbar t={t} />

		<main
			class="bg-base-100 shadow-sm card mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 lg:px-8"
		>
			<slot />
		</main>
	</body>

	<script>
		const imgs = document.querySelectorAll<HTMLImageElement>("img[src]");

		const reveal = (img: HTMLImageElement) => {
			img.classList.remove("skeleton");
			img.style.color = "";
		};

		for (const img of imgs) {
			if (img.complete) {
				reveal(img);
				continue;
			}

			img.classList.add("skeleton");
			img.addEventListener("load", () => reveal(img));
			img.addEventListener("error", () => reveal(img));
		}
	</script>
</html>
