---
// src/pages/index.astro
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import Layout from "../layouts/Layout.astro";
import PostCard from "../components/blog/PostCard.astro";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");

const recentPosts = posts
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const socials = [
	{ label: "GitHub", href: "https://github.com/pepecoral" },
	{ label: "LinkedIn", href: "https://linkedin.com/in/pepecoral" },
];
---

<Layout>
	<!-- Hero / CTA -->
	<section class="hero py-10 sm:py-16">
		<div class="hero-content flex-col text-center">
			<div class="avatar mb-6">
				<div class="w-28 sm:w-32 rounded-full">
					<img src="/avatar.png" alt="Pepe Coral" />
				</div>
			</div>

			<div class="badge badge-primary badge-outline mb-3">
				Available for work
			</div>

			<h1 class="text-4xl sm:text-5xl font-bold">Hi, I'm Pepe Coral</h1>
			<p class="py-4 max-w-xl text-base-content/70">
				Software engineer who likes building clean, fast web apps. I
				write about what I learn along the way — take a look below, or
				just say hi.
			</p>

			<div class="flex flex-wrap justify-center gap-3">
				<a href="mailto:hello@pepecoral.dev" class="btn btn-primary">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="size-4"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
					>
						<rect x="2" y="4" width="20" height="16" rx="2"></rect>
						<path d="m22 6-10 7L2 6"></path>
					</svg>
					Get in touch
				</a>

				{
					socials.map((s) => (
						<a
							href={s.href}
							target="_blank"
							rel="noopener noreferrer"
							class="btn
							btn-outline"
						>
							{s.label}
						</a>
					))
				}
			</div>
		</div>
	</section>

	<div class="divider"></div>

	<!-- Latest posts -->
	<section>
		<div class="mb-6 flex items-center justify-between">
			<h2 class="text-2xl font-bold">Latest posts</h2>
			<a href="/blog" class="link link-primary text-sm font-medium">
				View all &rarr;
			</a>
		</div>

		{
			recentPosts.length > 0 ? (
				<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{recentPosts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			) : (
				<p class="text-base-content/50 text-sm">
					No posts yet — check back soon.
				</p>
			)
		}
	</section>

	<div class="divider"></div>

	<!-- Bottom CTA -->
	<section class="text-center py-8">
		<h2 class="text-2xl font-bold mb-2">Got a project in mind?</h2>
		<p class="text-base-content/70 mb-6 max-w-md mx-auto">
			I'm always happy to hear about new ideas or opportunities. Drop me
			an email and I'll get back to you.
		</p>
		<a href="mailto:hello@pepecoral.dev" class="btn btn-primary btn-wide">
			Say hello
		</a>
	</section>
</Layout>
