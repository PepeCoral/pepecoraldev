---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Translation } from "../i18n/types";

const currentPath = Astro.url.pathname;

const isActive = (href: string) => currentPath.startsWith(href);

interface Props {
    t: Translation;
}

const { t } = Astro.props;

const currentPathWithoutLocale =
    t.locale === "en"
        ? Astro.url.pathname
        : Astro.url.pathname.replace(/^\/es/, "");

const navItems = [
    { href: "/projects", label: t.nav.projects },
    { href: "/blog", label: t.nav.blog },
    { href: "/contact", label: t.nav.contact },
];

const locales = [
    { code: "en", label: "English", short: "EN", aria: "Switch to English" },
    { code: "es", label: "Español", short: "ES", aria: "Cambiar a español" },
];
---

<div
    class="navbar bg-base-100 shadow-sm max-w-2xl mx-auto rounded-full px-2 sm:px-4 my-5"
>
    <div class="navbar-start">
        <!-- Mobile menu -->
        <details class="dropdown lg:hidden">
            <summary
                class="btn btn-ghost btn-circle list-none"
                aria-label="Open menu"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </summary>
            <ul
                class="menu dropdown-content bg-base-100 rounded-box z-10 mt-3 w-48 p-2 shadow-sm"
            >
                {
                    navItems.map(({ href, label }) => (
                        <li>
                            <a
                                href={getRelativeLocaleUrl(t.locale, href)}
                                class:list={{ "text-primary": isActive(href) }}
                            >
                                {label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </details>

        <a
            class="ml-1 lg:ml-4 font-bold text-xl text-primary"
            href={getRelativeLocaleUrl(t.locale, "/")}
        >
            {t.nav.pepe}
        </a>
    </div>

    <!-- Desktop menu -->
    <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1">
            {
                navItems.map(({ href, label }) => (
                    <li>
                        <a
                            href={getRelativeLocaleUrl(t.locale, href)}
                            class:list={{ "text-primary": isActive(href) }}
                        >
                            {label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>

    <div class="navbar-end">
        <details class="dropdown dropdown-end">
            <summary class="btn btn-ghost btn-sm rounded-full gap-1 list-none">
                {locales.find((l) => l.code === t.locale)?.short}
            </summary>
            <ul
                class="menu dropdown-content bg-base-100 rounded-box z-10 mt-3 w-36 p-2 shadow-sm"
            >
                {
                    locales.map((locale) => (
                        <li>
                            <a
                                href={getRelativeLocaleUrl(
                                    locale.code,
                                    currentPathWithoutLocale || "/",
                                )}
                                class:list={{
                                    active: t.locale === locale.code,
                                }}
                                aria-label={locale.aria}
                            >
                                {locale.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </details>
    </div>
</div>
