---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import Layout from "../../../layouts/Layout.astro";
import { PageTranslation } from "../../../i18n/types";
import getTranslation from "../../../i18n";

const t = getTranslation(Astro.params.locale);

export async function getStaticPaths() {
    const posts = await getCollection("blog");

    return posts.map((post: CollectionEntry<"blog">) => ({
        params: {
            slug: post.id,
        },
        props: {
            post,
        },
    }));
}

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, tags, image } = post.data;

const { Content } = await render(post);

const page: PageTranslation = { title, description };
---

<Layout t={t} page={page}>
    <article class="mx-auto max-w-3xl">
        <header class="mb-10">
            <div class="mb-4 flex flex-wrap gap-2">
                {
                    post.data.tags.map((tag: string) => (
                        <span class="badge badge-primary font-bold">{tag}</span>
                    ))
                }
            </div>

            <h1 class="text-4xl font-bold md:text-5xl">
                {title}
            </h1>

            <p class="mt-4 text-xl text-base-content/60">
                {description}
            </p>

            <time
                datetime={post.data.date.toISOString()}
                class="mt-4 block text-sm text-base-content/50"
            >
                {post.data.date.toLocaleDateString()}
            </time>

            <Image
                src={image}
                alt={title}
                class="mt-8 h-auto max-h-[500px] w-full rounded-2xl object-cover"
                width={1200}
                height={630}
            />
        </header>

        <div class="prose prose-lg max-w-none">
            <Content />
        </div>
    </article>
</Layout>
