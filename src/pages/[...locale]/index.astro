---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { CollectionEntry } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import PostCard from "../../components/blog/PostCard.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";

import getTranslation from "../../i18n";
export { getLocaleStaticPaths as getStaticPaths } from "../../i18n/routes";

const locale = Astro.params.locale ?? "en";
const t = getTranslation(locale);

const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");

const posts = allPosts.filter((post) => post.data.locale === locale);

const recentPosts = posts
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const allProjects: CollectionEntry<"projects">[] =
	await getCollection("projects");

const projects = allProjects.filter(
	(project) => project.data.locale === locale,
);

const socials = [
	{
		label: "GitHub",
		href: "https://github.com/pepecoral",
		icon: "github",
	},
	{
		label: "LinkedIn",
		href: "https://linkedin.com/in/pepe-coral",
		icon: "linkedin",
	},
];
---

<Layout t={t} page={t.home}>
	<section class="hero">
		<div class="hero-content flex-col text-center">
			<div class="avatar mb-6">
				<div class="w-28 sm:w-32 overflow-hidden rounded-full">
					<img
						class="skeleton aspect-square"
						src="/avatar.png"
						alt="Pepe Coral"
						style="color: transparent"
					/>
				</div>
			</div>

			<div class="badge badge-primary badge-outline mb-3">
				{t.home.workAvailable}
			</div>

			<h1 class="text-4xl sm:text-5xl font-bold">{t.home.h1}</h1>
			<p class="py-4 max-w-xl text-base-content/70">
				{t.home.body}
			</p>

			<div class="flex flex-wrap items-center justify-center gap-3">
				<button
					id="copy-email"
					type="button"
					class="btn btn-primary transition-colors duration-300"
					data-email="hello@pepecoral.dev"
				>
					<Icon name="copy" />
					<span id="copy-label" class="grid">
						<span
							class="col-start-1 row-start-1"
							data-copy-label-default>{t.home.copyEmail}</span
						>
						<span
							class="col-start-1 row-start-1 invisible"
							data-copy-label-copied>{t.home.copied}</span
						>
					</span>
				</button>
				<a href="/cv.pdf" download class="btn btn-outline">
					<Icon name="download" />
					{t.home.downloadCv}
				</a>

				{
					socials.map((s) => (
						<a
							href={s.href}
							target="_blank"
							rel="noopener noreferrer"
							class="btn
							btn-outline"
						>
							<Icon name={s.icon} />
							{s.label}
						</a>
					))
				}
			</div>
		</div>
	</section>

	<div class="divider"></div>

	<section>
		<div class="mb-6 flex items-center justify-between">
			<h2 class="text-2xl font-bold">{t.home.featuredProjects}</h2>
			<a
				href={getRelativeLocaleUrl(locale, "/projects")}
				class="link link-primary text-sm font-medium"
			>
				{t.home.viewAllProjects} &rarr;
			</a>
		</div>

		{
			projects.length > 0 ? (
				<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{projects.map((project) => (
						<ProjectCard project={project} locale={locale} t={t} />
					))}
				</div>
			) : (
				<p class="text-base-content/50 text-sm">
					No projects yet — check back soon.
				</p>
			)
		}
	</section>

	<div class="divider"></div>

	<section>
		<div class="mb-6 flex items-center justify-between">
			<h2 class="text-2xl font-bold">{t.home.latestPosts}</h2>
			<a
				href={getRelativeLocaleUrl(locale, "/blog")}
				class="link link-primary text-sm font-medium"
			>
				{t.home.viewAllPosts} &rarr;
			</a>
		</div>

		{
			recentPosts.length > 0 ? (
				<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
					{recentPosts.map((post) => (
						<PostCard post={post} locale={locale} />
					))}
				</div>
			) : (
				<p class="text-base-content/50 text-sm">
					No posts yet — check back soon.
				</p>
			)
		}
	</section>

	<script>
		const email = "hello@pepecoral.dev";
		const button = document.querySelector<HTMLButtonElement>("#copy-email");

		const CONFETTI_COLORS = [
			"#db4f1d",
			"#24B0E2",
			"#f1c40f",
			"#2ecc71",
			"#e91e63",
			"#8e44ad",
		];

		const throwConfetti = (originX: number, originY: number) => {
			const canvas = document.createElement("canvas");
			canvas.width = window.innerWidth;
			canvas.height = window.innerHeight;
			canvas.style.cssText =
				"position:fixed;inset:0;pointer-events:none;z-index:9999;";
			document.body.appendChild(canvas);

			const ctx = canvas.getContext("2d");
			if (!ctx) {
				canvas.remove();
				return;
			}

			const duration = 2500;
			let last = performance.now();

			const particles = Array.from({ length: 50 }, () => {
				const angle = Math.random() * Math.PI * 2;
				const speed = 5 + Math.random() * 9;

				return {
					x: originX,
					y: originY,
					vx: Math.cos(angle) * speed,
					vy: Math.sin(angle) * speed - (4 + Math.random() * 5),
					w: 6 + Math.random() * 6,
					h: 10 + Math.random() * 8,
					color: CONFETTI_COLORS[
						(Math.random() * CONFETTI_COLORS.length) | 0
					],
					rotation: Math.random() * Math.PI,
					rotSpeed: (Math.random() - 0.5) * 0.4,
				};
			});

			const tick = (now: number) => {
				const progress = Math.min(1, (now - last) / 16.67);
				last = now;

				const alpha =
					1 - Math.min(1, (now - particlesStart) / duration);

				ctx.clearRect(0, 0, canvas.width, canvas.height);
				ctx.globalAlpha = Math.max(0, alpha);

				for (const p of particles) {
					p.vy += 0.22 * progress;
					p.vx *= 0.992;
					p.vy *= 0.992;
					p.x += p.vx * progress;
					p.y += p.vy * progress;
					p.rotation += p.rotSpeed * progress;

					ctx.save();
					ctx.translate(p.x, p.y);
					ctx.rotate(p.rotation);
					ctx.fillStyle = p.color;
					ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
					ctx.restore();
				}

				if (now - particlesStart < duration) {
					requestAnimationFrame(tick);
				} else {
					canvas.remove();
				}
			};

			const particlesStart = performance.now();
			requestAnimationFrame(tick);
		};

		if (button) {
			const defaultLabel = button.querySelector<HTMLSpanElement>(
				"[data-copy-label-default]",
			);
			const copiedLabel = button.querySelector<HTMLSpanElement>(
				"[data-copy-label-copied]",
			);

			let timeout: number | undefined;

			button.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(email);

					const rect = button.getBoundingClientRect();
					throwConfetti(
						rect.left + rect.width / 2,
						rect.top + rect.height / 2,
					);

					button.classList.remove("btn-primary");
					button.classList.add("btn-secondary");

					button.classList.remove("animate-copied-pop");
					void button.offsetWidth;
					button.classList.add("animate-copied-pop");

					defaultLabel?.classList.add("invisible");
					copiedLabel?.classList.remove("invisible");

					clearTimeout(timeout);
					timeout = window.setTimeout(() => {
						defaultLabel?.classList.remove("invisible");
						copiedLabel?.classList.add("invisible");

						button.classList.remove(
							"btn-secondary",
							"animate-copied-pop",
						);
						button.classList.add("btn-primary");
					}, 2000);
				} catch {
					window.location.href = `mailto:${email}`;
				}
			});
		}
	</script>
</Layout>
