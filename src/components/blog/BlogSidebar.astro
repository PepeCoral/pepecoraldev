---
interface Props {
    tags: string[];
    years: number[];
}

const { tags, years } = Astro.props;
---

<div class="flex flex-col gap-6 lg:sticky lg:top-20">
    <label class="input input-bordered flex items-center gap-2">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="h-4 w-4 opacity-50"
        >
            <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
            id="search-input"
            type="text"
            placeholder="Search posts..."
            class="grow"
        />
    </label>

    <div>
        <h3
            class="mb-3 text-sm font-semibold uppercase tracking-wide text-base-content/50"
        >
            Year
        </h3>
        <div id="year-filters" class="flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-active" data-year="all"
                >All</button
            >
            {
                years.map((year) => (
                    <button
                        type="button"
                        class="btn btn-outline btn-sm"
                        data-year={year}
                    >
                        {year}
                    </button>
                ))
            }
        </div>
    </div>

    <div>
        <h3
            class="mb-3 text-sm font-semibold uppercase tracking-wide text-base-content/50"
        >
            Tags
        </h3>
        <div id="tag-filters" class="flex flex-wrap gap-2">
            {
                tags.map((tag) => (
                    <button
                        type="button"
                        class="badge badge-outline cursor-pointer"
                        data-tag={tag.toLowerCase()}
                    >
                        {tag}
                    </button>
                ))
            }
        </div>
    </div>

    <button
        type="button"
        id="clear-filters"
        class="btn btn-ghost btn-sm self-start"
    >
        Clear filters
    </button>
</div>
