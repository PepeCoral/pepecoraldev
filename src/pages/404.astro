---
import { getRelativeLocaleUrl } from "astro:i18n";

import Layout from "../layouts/Layout.astro";
import getTranslation from "../i18n";

const t = getTranslation(undefined);
const locale = "en";
---

<Layout t={t} page={t.notFound}>
    <section class="flex flex-col items-center py-16 text-center">
        <div class="text-8xl font-bold text-base-content/20">404</div>

        <h1 class="mt-4 text-3xl font-bold">{t.notFound.h1}</h1>
        <p class="mt-3 max-w-md text-base-content/70">
            {t.notFound.body}
        </p>

        <a
            href={getRelativeLocaleUrl(locale, "/")}
            class="btn btn-primary mt-8"
        >
            {t.notFound.backHome}
        </a>
    </section>
</Layout>