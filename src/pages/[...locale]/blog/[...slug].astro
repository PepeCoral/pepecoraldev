---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import Layout from "../../../layouts/Layout.astro";
import type { PageTranslation } from "../../../i18n/types";
import getTranslation from "../../../i18n";
import { localePaths } from "../../../i18n/routes";
import Icon from "../../../components/Icon.astro";
import PostToc from "../../../components/blog/PostToc.astro";

const locale = Astro.params.locale ?? "en";
const t = getTranslation(locale);

export async function getStaticPaths() {
    const posts = await getCollection("blog");

    return posts.flatMap((post: CollectionEntry<"blog">) =>
        localePaths.flatMap(({ params: { locale } }) => {
            const normalized = locale ?? "en";
            if (post.data.locale !== normalized) {
                return [];
            }
            return [
                {
                    params: {
                        locale,
                        slug: post.data.slug,
                    },
                    props: {
                        post,
                    },
                },
            ];
        }),
    );
}

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, tags, image, links } = post.data;

const { Content, headings } = await render(post);

const tocHeadings = headings.filter((heading) => heading.depth > 1);

const page: PageTranslation = { title, description };
---

<Layout t={t} page={page}>
    <article class="mx-auto">
        <header class="mb-10">
            <div class="mb-4 flex flex-wrap gap-2">
                {
                    post.data.tags.map((tag: string) => (
                        <span class="badge badge-primary font-bold">{tag}</span>
                    ))
                }
            </div>

            <h1 class="text-3xl font-bold md:text-5xl">
                {title}
            </h1>

            <p class="mt-4 text-lg text-base-content/60 md:text-xl">
                {description}
            </p>

            <time
                datetime={post.data.date.toISOString()}
                class="mt-4 block text-sm text-base-content/50"
            >
                {post.data.date.toLocaleDateString(locale)}
            </time>

            {
                links.length > 0 && (
                    <div class="mt-4 flex flex-wrap items-center gap-3">
                        {links.map((link) => (
                            <a
                                href={link.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class:list={[
                                    link.pageClass ?? "btn btn-primary btn-sm",
                                ]}
                            >
                                <span class="inline-flex items-center gap-1.5">
                                    {link.icon && <Icon name={link.icon} class="size-4" />}
                                    {link.page}
                                </span>
                            </a>
                        ))}
                    </div>
                )
            }

            <Image
                src={image}
                alt={title}
                class="skeleton mt-8 h-auto max-h-[500px] w-full rounded-2xl object-cover"
                style="color: transparent"
                width={1200}
                height={630}
            />
        </header>

        <div class="mb-8">
            <PostToc
                headings={tocHeadings}
                label={t.blogArticle.onThisPage}
            />
        </div>

        <div class="prose max-w-none md:prose-lg">
            <Content />
        </div>
    </article>
</Layout>
