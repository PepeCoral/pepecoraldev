---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Translation } from "../i18n/types";

const currentPath = Astro.url.pathname;

const isActive = (href: string) => currentPath.startsWith(href);

interface Props {
    t: Translation;
}

const { t } = Astro.props;

const currentPathWithoutLocale =
    t.locale === "en"
        ? Astro.url.pathname
        : Astro.url.pathname.replace(/^\/es/, "");

const navItems = [
    { href: "/projects", label: t.nav.projects },
    { href: "/blog", label: t.nav.blog },
    { href: "/contact", label: t.nav.contact },
];
---

<div
    class="navbar bg-base-100 shadow-sm max-w-2xl mx-auto rounded-full px-4 my-5"
>
    <div class="navbar-start">
        <a
            class="ml-4 font-bold text-xl text-primary"
            href={getRelativeLocaleUrl(t.locale, "/")}>{t.nav.pepe}</a
        >
    </div>

    <ul class="navbar-center flex menu menu-horizontal px-1">
        {
            navItems.map(({ href, label }) => (
                <li>
                    <a
                        href={getRelativeLocaleUrl(t.locale, href)}
                        class:list={{ "text-primary": isActive(href) }}
                    >
                        {label}
                    </a>
                </li>
            ))
        }
        <li>
            <div class="join rounded-full bg-base-200 p-1">
                <a
                    href={getRelativeLocaleUrl(
                        "en",
                        currentPathWithoutLocale || "/",
                    )}
                    class:list={{
                        "btn btn-sm join-item rounded-full": true,
                        "btn-primary": t.locale === "en",
                        "btn-ghost": t.locale !== "en",
                    }}
                    aria-label="Switch to English"
                >
                    EN
                </a>

                <a
                    href={getRelativeLocaleUrl(
                        "es",
                        currentPathWithoutLocale || "/",
                    )}
                    class:list={{
                        "btn btn-sm join-item rounded-full": true,
                        "btn-primary": t.locale === "es",
                        "btn-ghost": t.locale !== "es",
                    }}
                    aria-label="Cambiar a español"
                >
                    ES
                </a>
            </div>
        </li>
    </ul>
</div>
